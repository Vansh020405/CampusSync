generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Student {
  id               String                        @id @default(uuid())
  name             String
  rollNo           String                        @unique
  section          String
  department       String
  semester         String
  email            String?
  password         String
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @default(now()) @updatedAt
  batch            String                        @default("Morning")
  resumeText       String?                       
  resumeScore      Float?
  acknowledgements AnnouncementAcknowledgement[]
  applications     Application[]
  bookings         Booking[]
  examSeating      ExamSeating[]
  grades           Grade[]
  riskScores       RiskScore[]
  attendance       StudentAttendance[]
  leaves           StudentLeave[]
}

model Faculty {
  id               String              @id @default(uuid())
  name             String
  facultyId        String              @unique
  department       String
  subjects         String
  sectionsTeaching String
  cabinLocation    String?
  status           String              @default("AVAILABLE")
  password         String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  email            String?
  bookings         Booking[]
  examDuties       Exam[]              @relation("InvigilatorDuty")
  attendance       FacultyAttendance[]
  leaves           FacultyLeave[]
  timetable        FacultyTimetable[]
  gradeVersions    GradeVersion[]
  sentMessages     Message[]           @relation("SentMessages")
  mentoredSections SectionMentor[]
  markings         StudentAttendance[]
  leaveApprovals   StudentLeave[]      @relation("LeaveApprovals")
  assignedClasses  Timetable[]         @relation("FacultyClasses")
  topicProgress    TopicProgress[]
}

model Admin {
  id         String   @id @default(uuid())
  username   String   @unique
  password   String
  name       String?
  createdAt  DateTime @default(now())
  position   String?
  department String?
  subjects   String?
}

model Timetable {
  id         String   @id @default(uuid())
  department String
  section    String
  semester   String
  subject    String
  facultyId  String
  classroom  String
  floor      String
  day        String
  startTime  String
  endTime    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  batch      String   @default("Morning")
  faculty    Faculty  @relation("FacultyClasses", fields: [facultyId], references: [id])

  @@index([department, section, semester, batch])
  @@index([facultyId, day])
}

model StudentAttendance {
  id        String   @id @default(uuid())
  studentId String
  facultyId String
  subject   String
  date      DateTime
  period    Int      @default(1)
  status    String
  createdAt DateTime @default(now())
  faculty   Faculty  @relation(fields: [facultyId], references: [id])
  student   Student  @relation(fields: [studentId], references: [id])

  @@index([studentId, subject])
  @@index([subject, date, period])
}

model FacultyAttendance {
  id        String   @id @default(uuid())
  facultyId String
  date      DateTime
  status    String
  leaveType String?
  createdAt DateTime @default(now())
  faculty   Faculty  @relation(fields: [facultyId], references: [id])

  @@unique([facultyId, date])
}

model Message {
  id              String   @id @default(uuid())
  senderId        String
  senderRole      String   @default("FACULTY")
  receiverSection String
  message         String
  timestamp       DateTime @default(now())
  sender          Faculty  @relation("SentMessages", fields: [senderId], references: [id])

  @@index([receiverSection])
}

model FacultyTimetable {
  id        String   @id @default(uuid())
  facultyId String
  day       String
  startTime String
  endTime   String
  isFree    Boolean  @default(false)
  subject   String?
  room      String?
  createdAt DateTime @default(now())
  faculty   Faculty  @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  @@index([facultyId, day])
}

model Booking {
  id         String    @id @default(uuid())
  studentId  String
  facultyId  String
  slotDate   DateTime?
  slotTime   String?
  location   String?
  agenda     String
  agendaType String
  status     String    @default("PENDING")
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  faculty    Faculty   @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  student    Student   @relation(fields: [studentId], references: [id])

  @@index([facultyId, status])
  @@index([studentId, status])
}

model FacultyLeave {
  id        String   @id @default(uuid())
  facultyId String
  fromDate  DateTime
  toDate    DateTime
  reason    String
  status    String   @default("PENDING")
  appliedAt DateTime @default(now())
  faculty   Faculty  @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  @@index([facultyId, status])
}

model StudentLeave {
  id          String   @id @default(uuid())
  studentId   String
  facultyId   String
  fromDate    DateTime
  toDate      DateTime
  reason      String
  documentUrl String?
  status      String   @default("PENDING")
  appliedAt   DateTime @default(now())
  faculty     Faculty  @relation("LeaveApprovals", fields: [facultyId], references: [id], onDelete: Cascade)
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([facultyId, status])
  @@index([studentId, status])
}

model Internship {
  id               String        @id @default(uuid())
  company          String
  role             String
  stipend          String
  location         String
  mode             String
  eligibilityCgpa  Float
  branchesAllowed  String
  deadline         DateTime
  jdUrl            String?
  applyLink        String?
  description      String?
  skills           String
  selectionProcess String?
  createdAt        DateTime      @default(now())
  applications     Application[]
}

model Application {
  id           String     @id @default(uuid())
  studentId    String
  internshipId String
  status       String
  appliedAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  internship   Internship @relation(fields: [internshipId], references: [id])
  student      Student    @relation(fields: [studentId], references: [id])

  @@unique([studentId, internshipId])
}

model SyllabusSubject {
  id          String              @id @default(uuid())
  subjectName String              @unique
  subjectCode String?
  department  String
  assignments SubjectAssignment[]
  topics      SyllabusTopic[]
}

model SyllabusTopic {
  id            String          @id @default(uuid())
  subjectId     String
  title         String
  totalLectures Int             @default(1)
  order         Int             @default(0)
  examType      String?
  subject       SyllabusSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  progress      TopicProgress[]
}

model SubjectAssignment {
  id         String          @id @default(uuid())
  subjectId  String
  department String
  semester   String
  batch      String
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  subject    SyllabusSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([subjectId, department, semester, batch])
}

model TopicProgress {
  id                String        @id @default(uuid())
  topicId           String
  facultyId         String
  section           String
  status            String        @default("NOT_STARTED")
  completedLectures Int           @default(0)
  completedDate     DateTime?
  notes             String?
  updatedAt         DateTime      @updatedAt
  faculty           Faculty       @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  topic             SyllabusTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([topicId, facultyId, section])
}

model Exam {
  id            String        @id @default(uuid())
  name          String        @default("Examination")
  subject       String
  department    String?
  semester      String?
  section       String?
  date          DateTime
  startTime     String
  endTime       String
  duration      String
  type          String
  room          String
  hall          String?
  block         String?
  floor         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  invigilatorId String?
  invigilator   Faculty?      @relation("InvigilatorDuty", fields: [invigilatorId], references: [id])
  seating       ExamSeating[]
}

model ExamSeating {
  id        String  @id @default(uuid())
  examId    String
  studentId String
  seatNo    String
  exam      Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([examId, studentId])
}

model Grade {
  id            String        @id @default(uuid())
  studentId     String
  semester      String
  subjectName   String
  subjectCode   String
  internalMarks Int
  externalMarks Int
  totalMarks    Int
  grade         String
  credits       Int           @default(3)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  endTermMarks  Float?
  endTermTotal  Float?
  st1Marks      Float?
  st1Total      Float?
  st2Marks      Float?
  st2Total      Float?
  versionId     String?
  student       Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  gradeVersion  GradeVersion? @relation(fields: [versionId], references: [id])

  @@unique([studentId, subjectName])
  @@index([studentId, semester])
}

model Announcement {
  id               String                        @id @default(uuid())
  content          String
  department       String                        @default("ALL")
  semester         String                        @default("ALL")
  batch            String                        @default("ALL")
  senderId         String
  createdAt        DateTime                      @default(now())
  acknowledgements AnnouncementAcknowledgement[]

  @@index([department, semester, batch])
}

model AnnouncementAcknowledgement {
  id             String       @id @default(uuid())
  announcementId String
  studentId      String
  createdAt      DateTime     @default(now())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([announcementId, studentId])
}

model SectionMentor {
  id         String   @id @default(uuid())
  department String
  semester   String
  section    String
  batch      String   @default("Morning")
  facultyId  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  faculty    Faculty  @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  @@unique([department, semester, section, batch])
}

model GradeVersion {
  id        String   @id @default(uuid())
  versionId String   @unique
  facultyId String
  createdAt DateTime @default(now())
  grades    Grade[]
  faculty   Faculty  @relation(fields: [facultyId], references: [id])
}

model RiskScore {
  id                 String   @id @default(uuid())
  studentId          String
  subjectName        String
  riskScore          Float
  riskCategory       String
  trend              String   @default("STABLE")
  attendance         Float?
  recommendations    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  priority           Int      @default(0)
  requiredAttendance String?
  requiredMarks      String?
  student            Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, subjectName])
}

model ExamAnalysis {
  id          String   @id @default(uuid())
  subjectName String
  topic       String
  frequency   Int
  weightage   Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
